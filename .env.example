# ============================================================
# 投融资知识库管理平台 - 环境变量模板（演示/部署共用）
# 用法：cp .env.example .env  然后填入真实值
# 注意：.env 已被 .gitignore 排除，严禁提交真实密钥到 git
# ============================================================

# ============ MySQL ============
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=请改成强密码
MYSQL_DATABASE=investment_finance

# ============ Redis ============
REDIS_URL=redis://redis:6379/0

# ============ Elasticsearch ============
ES_HOSTS=http://elasticsearch:9200
ES_INDEX_PREFIX=if_knowledge

# ============ Milvus ============
# 默认嵌入式 Milvus Lite（backend 容器内 /app/data/milvus.db，命名卷持久化）
MILVUS_LITE_URI=/app/data/milvus.db
# 如改用独立 Milvus 服务，留空 MILVUS_LITE_URI 并配置 host/port
# MILVUS_HOST=milvus
# MILVUS_PORT=19530

# ============ LLM（OpenAI 兼容网关，SiliconFlow 等） ============
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-你的真实密钥
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

# ============ Embedding ============
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-你的真实密钥
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ============ 上传 ============
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=50

# ============ 应用 ============
APP_NAME=investment-finance
APP_ENV=production
DEBUG=false
SECRET_KEY=运行 python -c "import secrets; print(secrets.token_urlsafe(64))" 生成
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
